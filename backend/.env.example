# ── API ────────────────────────────────────────────────
API_ENV=development               # development | production
API_SECRET_KEY=change-me-to-a-64-char-random-string
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sajjad:sajjad@localhost:5432/sajjad_db

# ── Redis / Celery ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email (SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=noreply@sajjad.app
SMTP_TLS=false             # true para SSL/465, false para STARTTLS/587
SMTP_STARTTLS=true
EMAIL_FROM_NAME=Sajjad EASM

# ── Mercado Pago ───────────────────────────────────────
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_webhook_secret
MP_PLAN_STARTER_ID=       # ID del plan preapproval en MP
MP_PLAN_PROFESSIONAL_ID=
MP_PLAN_AGENCY_ID=

# ── Scanner ────────────────────────────────────────────
SCAN_TIMEOUT=300
NUCLEI_RATE_LIMIT=150
PDF_STORAGE_PATH=/tmp/sajjad/reports

# ── OSINT APIs (opcionales) ───────────────────────────
HIBP_API_KEY=
GITHUB_TOKEN=
SHODAN_API_KEY=
