# ── API ────────────────────────────────────────────────
API_ENV=development               # development | production
# En producción esto DEBE cambiarse o la API se niega a arrancar.
# Genera uno con: openssl rand -hex 32
API_SECRET_KEY=change-me
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Hosts aceptados por TrustedHostMiddleware (sólo en producción)
ALLOWED_HOSTS=sajjad.app,*.sajjad.app

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sajjad:sajjad@localhost:5432/sajjad_db

# ── Redis / Celery ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email (SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=noreply@sajjad.app
SMTP_TLS=false             # true para SSL/465, false para STARTTLS/587
SMTP_STARTTLS=true
EMAIL_FROM_NAME=Sajjad EASM

# ── Prueba gratuita ────────────────────────────────────
# Días de prueba con capacidades Professional, otorgados al
# verificar el email. 0 desactiva el trial.
TRIAL_DAYS=14

# ══════════════════════════════════════════════════════════
# ── Facturación / Mercado Pago ─────────────────────────
# ══════════════════════════════════════════════════════════
#
# INTERRUPTOR MAESTRO. Con esto en false el producto funciona
# entero (registro, trial, escaneos, PDF) pero no se cobra:
#   · POST /billing/checkout  → 503 BillingDisabled
#   · POST /billing/cancel    → 503 BillingDisabled
#   · POST /billing/webhook   → 404 (ni siquiera existe)
#   · La UI ofrece "contactar" en vez del botón de pago
#
# PARA ACTIVAR LOS PAGOS, todo lo que hay que hacer es:
#   1. Rellenar MP_ACCESS_TOKEN y MP_WEBHOOK_SECRET abajo
#   2. Poner BILLING_ENABLED=true
#   3. Reiniciar la API
# No hay que tocar ni una línea de código.
#
# En producción, BILLING_ENABLED=true sin esas dos credenciales
# hace que la API se niegue a arrancar (fallo ruidoso al
# desplegar en vez de silencioso en caliente).
BILLING_ENABLED=false

MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Secreto de firma del webhook (Panel MP → Webhooks).
# Sin él, TODO webhook entrante se rechaza: este endpoint otorga
# planes, así que nunca se acepta lo que no se puede verificar.
MP_WEBHOOK_SECRET=

# ── Scanner ────────────────────────────────────────────
SCAN_TIMEOUT=300
NUCLEI_RATE_LIMIT=150
PDF_STORAGE_PATH=/tmp/sajjad/reports

# ── OSINT APIs (opcionales) ───────────────────────────
HIBP_API_KEY=
GITHUB_TOKEN=
SHODAN_API_KEY=

# ── Observabilidad (opcional) ─────────────────────────
# Sin DSN, Sentry queda desactivado y no hace falta instalar la
# dependencia (extra "monitoring"). En producción los logs salen
# en JSON de una línea por evento, con request_id correlacionado.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RELEASE_VERSION=dev

# ── Rate limiting ─────────────────────────────────────
# Los contadores viven en Redis para que el límite sea global entre
# los workers de uvicorn. Ponerlo en false SÓLO en tests.
RATE_LIMIT_ENABLED=true
